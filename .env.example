# AI Video Editor Agent — copy to .env and edit. Never commit .env.
AI_PROVIDER=openai-compatible
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_VISION_MODEL=gpt-4.1-mini
AI_STT_MODEL=whisper-1
AI_TEMPERATURE=0.35
AI_MAX_TOKENS=6000

# Override when FFmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Runtime storage (relative paths are resolved from the repository root).
PROJECTS_DIR=projects
MAX_UPLOAD_GB=20
ASSET_DOWNLOAD_MAX_MB=500
